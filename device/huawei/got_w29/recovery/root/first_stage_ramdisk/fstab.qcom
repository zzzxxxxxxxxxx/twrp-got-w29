system                                              /system             erofs   ro   wait,logical,first_stage_mount
vendor                                              /vendor             erofs   ro   wait,logical,first_stage_mount
odm                                                 /odm                erofs   ro   wait,logical,first_stage_mount
hw_product                                          /hw_product         erofs   ro   wait,logical,first_stage_mount
cust                                                /cust               erofs   ro   wait,logical,first_stage_mount
/dev/block/by-name/metadata                         /metadata           ext4    noatime,nosuid,nodev,discard wait,check,formattable
/dev/block/by-name/userdata                         /data               f2fs    noatime,nosuid,nodev,discard,inlinecrypt wait,check,latemount,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0,metadata_encryption=aes-256-xts:wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption

